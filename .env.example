# ──────────────────────────────────────────
# Environment variables for Navratri Face Pass
# Copy to .env and fill in real values
# ──────────────────────────────────────────

# Django core
DEBUG=True
SECRET_KEY=django-insecure-CHANGE-ME-in-production
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Database (leave empty for SQLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/navratri_face_pass

# Redis cache (leave empty for LocMemCache)
# REDIS_URL=redis://localhost:6379/0

# Azure Blob Storage (leave empty for local /media)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=navratri-passes
AZURE_SAS_EXPIRY_MINUTES=10

# Azure OpenAI (for pass‑number OCR from pass photo)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Gate security
GATE_KEY=change-me-in-production
GATE_MAX_ENTRIES_PER_DAY=1

# Face engine tuning
FACE_MATCH_THRESHOLD=0.45
FACE_REVIEW_THRESHOLD=0.35
FACE_MIN_DET_SCORE=0.6
FACE_MIN_FACE_SIZE=80
FACE_BLUR_THRESHOLD=50.0
FACE_MODEL_PACK=buffalo_l
FACE_USE_GPU=False

# Security (production)
# SECURE_SSL_REDIRECT=True

# Logging
LOG_LEVEL=INFO
